PORT=3001
# Ambil Connection String dari dashboard Neon DB (menu Connect)
DATABASE_URL=postgresql://<user>:<password>@<host-neon>/neondb?sslmode=require
WEB_ORIGIN=http://localhost:3000
# Khusus jika pipeline analisis lokal ingin dipicu lewat GitHub Actions.
GITHUB_ACTIONS_REPOSITORY=
GITHUB_ACTIONS_TOKEN=
RESEND_API_KEY=
DAISUKI_PYTHON_BIN=python
# Opsional: override model aktif; path absolut atau relatif root workspace
DAISUKI_MODEL_PATH=
# Asisten model via Hugging Face. Kosongkan untuk memakai worker Python lokal.
# Diisi -> API tidak menjalankan Python dan tidak membaca daisuki.pkl sama sekali.
RAG_BRIDGE_URL=
RAG_BRIDGE_TOKEN=
RAG_BRIDGE_TIMEOUT_MS=8000
RAG_BRIDGE_HEALTH_TIMEOUT_MS=20000
LLM_ENABLED=true
LLM_BASE_URL=http://localhost:20128/v1
LLM_TUNNEL_URL=
LLM_API_KEY=
LLM_MODEL=opn
LLM_TIMEOUT_MS=25000
LLM_LOCAL_TIMEOUT_MS=15000
LLM_TUNNEL_TIMEOUT_MS=10000
ASSISTANT_RELAXED_CHAT=false
