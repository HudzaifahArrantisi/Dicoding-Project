{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daisuki-api",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [{ "binding": "DAISUKI_MODEL", "id": "b935acaac9e34d93b1aa23f479e624db" }],
  "vars": {
    "GITHUB_ACTIONS_REPOSITORY": "HudzaifahArrantisi/Dicoding-Project",
    "LLM_BASE_URL": "https://rfngsre.abc-tunnel.us/v1",
    "LLM_ENABLED": "true",
    "LLM_MODEL": "cmd",
    "NODE_ENV": "production",
    "WEB_ORIGIN": "https://daisuki.my.id"
  },
  "workers_dev": true,
  "routes": [{ "pattern": "api.daisuki.my.id/*", "zone_name": "daisuki.my.id" }],
  "observability": {
    "enabled": true
  },
  // Waktu cron Workers mengikuti UTC. Jadwal di index.ts memakai Asia/Jakarta
  // (UTC+7), jadi digeser tujuh jam ke belakang.
  //   05.00 WIB Senin  -> 22.00 UTC Minggu
  //   09.00 WIB harian -> 02.00 UTC
  "triggers": {
    "crons": ["0 22 * * SUN", "0 2 * * *"]
  }
}
