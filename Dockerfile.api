FROM oven/bun:1 AS bun-runtime

FROM python:3.11-slim
WORKDIR /app
COPY --from=bun-runtime /usr/local/bin/bun /usr/local/bin/bun
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DAISUKI_PYTHON_BIN=/usr/local/bin/python PORT=3001

COPY ai/requirements.txt ai/requirements.txt
RUN pip install --no-cache-dir -r ai/requirements.txt
COPY package.json bun.lock ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN bun install --frozen-lockfile --production
COPY apps/api apps/api
COPY packages/shared packages/shared
COPY ai ai
COPY data-science data-science
RUN mkdir -p ai/data/private ai/data/mainbrain/models && chown -R 10001:10001 /app
USER 10001:10001
EXPOSE 3001
CMD ["bun", "run", "--cwd", "apps/api", "start"]
