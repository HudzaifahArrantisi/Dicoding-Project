{
  "name": "daisuki-inventory",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "dev:web": "bun run --cwd apps/web dev:web",
    "dev:api": "bun run --cwd apps/api dev",
    "typecheck": "bun run --cwd apps/web typecheck && bun run --cwd apps/api typecheck"
  }
}
